PAYLOAD_SECRET="CHANGE_ME_generate_a_random_secret"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Database (Neon / Vercel Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Email — Resend (https://resend.com)
# Used by Payload's resendAdapter for password reset, verification, etc.
# While you're on the free tier or testing, leave RESEND_FROM_ADDRESS blank
# to fall back to `onboarding@resend.dev` (Resend's testing domain).
# For production, verify your Porkbun domain in the Resend dashboard
# and set RESEND_FROM_ADDRESS to e.g. `noreply@yourdomain.com`.
RESEND_API_KEY=
# Leave blank to use Resend's shared testing domain (onboarding@resend.dev).
# The testing domain can ONLY send to the email registered on your Resend account.
# For production, verify your domain at resend.com/domains and set this to e.g. noreply@yourdomain.com
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME="Agency Admin"

# Where contact-form enquiries are delivered (and the auto-reply's Reply-To).
# Used by src/plugins/formHooks/beforeEmail.ts. e.g. info@yourdomain.com
CONTACT_NOTIFICATION_EMAIL=

# Secret guarding the /next/preview draft endpoint. Generate with `openssl rand -hex 32`.
# Must match the value set in Vercel (Production + Preview).
PREVIEW_SECRET=

# Secret authorizing Vercel Cron-triggered Payload jobs (payload.config.ts `jobs.access`).
# Generate with `openssl rand -hex 32` and set the same value in the Vercel Cron config.
CRON_SECRET=

# Optional second Google Search Console verification method (HTML meta tag) emitted
# by src/app/(frontend)/layout.tsx `generateMetadata`. Omit to emit nothing — the
# Domain property's DNS TXT record is the primary method. The value is the
# `google-site-verification` token (public by design). Set in .env + Vercel if desired.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Admin bootstrap script (scripts/create-admin.ts)
# Required only when running the create-admin script to create/recover an admin user.
# Never commit actual values — set these in .env (gitignored) or pass inline.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Admin"

# Seeding (destructive) — /next/seed
# Requires SEED_ALLOW_DESTRUCTIVE=true, and refuses on Vercel production unless
# ALLOW_PROD_SEED=true (see .clinerules Rule #17). Leave both UNSET in normal use:
# seeding is for fresh, empty databases only.
SEED_ALLOW_DESTRUCTIVE=
ALLOW_PROD_SEED=

# ─────────────────────────────────────────────────────────────
# Platform-injected (Vercel) — do NOT set these manually:
#   VERCEL_ENV                     build/runtime environment ("production"|"preview")
#   VERCEL_PROJECT_PRODUCTION_URL  used to derive NEXT_PUBLIC_SERVER_URL in next.config.js
#   __NEXT_PRIVATE_ORIGIN          fallback origin used locally
# They are populated by Vercel automatically and listed here only for reference.
# ─────────────────────────────────────────────────────────────
